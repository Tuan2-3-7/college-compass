# Copy to backend/.env (gitignored) and fill in what you need.
# Every value here is optional - with none set, the app runs on the
# deterministic mock provider and a local SQLite database.

# ---- database ----
# SQLite by default. For deployment use Postgres (e.g. a free Neon database):
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# ---- security (REQUIRED before deploying publicly) ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without this, anyone reading the source can forge a login for any student.
# JWT_SECRET=

# ---- AI provider ----
# LLM_PROVIDER: auto (default) | mock | anthropic | openai_compat | ollama
# "auto" picks the best configured option: anthropic -> openai_compat -> mock.
# LLM_PROVIDER=auto

# Best quality, paid (~6 cents per essay analysis).
# https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Any OpenAI-compatible endpoint - hosted open models, free tiers available,
# nothing to run yourself. Groq's free tier:
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=llama-3.1-8b-instant

# Local Ollama - free and private, but only reachable from the machine running
# it (fine for development, not for a deployed app).
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ---- data ingestion ----
# Free key from https://api.data.gov/signup/ - only needed to re-run the
# College Scorecard sync, never at runtime.
# SCORECARD_API_KEY=
